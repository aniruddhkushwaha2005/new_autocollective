# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Authentication
JWT_SECRET="replace-with-strong-random-secret-in-production"
JWT_EXPIRES_IN="24h"

# Database (SQLite embedded default for preview; MongoDB Atlas URI for Python FastAPI backend)
SQLITE_DB_PATH="./autocollective.db"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/autocollective?retryWrites=true&w=majority"
MONGODB_DB_NAME="autocollective"

# Email / Forgot Password Development Mode
MAIL_MODE="development"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
